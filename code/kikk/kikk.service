[Unit]
Description=Familect backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiki
Group=kiki
WorkingDirectory=/home/kiki/familect
EnvironmentFile=/home/kiki/.config/familect.env
ExecStart=/home/kiki/familect/bin/start-backend.sh
Restart=always
RestartSec=5
RestartPreventExitStatus=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
